<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TajsToucher.Tests" />
    <PackageReference Include="Yubico.YubiKey" Version="1.17.3" GeneratePathProperty="true" />
    <None Include="$(NuGetPackageRoot)yubico.yubikey/1.17.3/LICENSE.txt" Link="licenses/Yubico.YubiKey.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)yubico.core/1.17.3/LICENSE.txt" Link="licenses/Yubico.Core.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
