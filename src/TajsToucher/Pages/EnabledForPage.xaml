<Page
    x:Class="TajsToucher.Pages.EnabledForPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="36,28,36,48" Spacing="14">
            <TextBlock Text="Enabled for"
                       Foreground="{StaticResource InkBrush}"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="The adapters currently connected to TajsToucher."
                       Foreground="{StaticResource MutedBrush}"
                       Margin="0,0,0,8" />

            <Border Background="{StaticResource CardBackgroundBrush}" Padding="18" CornerRadius="2">
                <StackPanel Spacing="6">
                    <TextBlock Text="Git / OpenPGP signing" Foreground="{StaticResource InkBrush}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="●  Enabled" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="Shows a notification when Git asks GnuPG to create a signature. Verification operations stay quiet."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="Coming later"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,8,0,0" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Background="{StaticResource CardBackgroundBrush}" Padding="16,12,16,10" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <TextBlock Text="OpenPGP operations" Foreground="{StaticResource DisabledBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="●  Not enabled" Foreground="{StaticResource DisabledBrush}" />
                        <TextBlock Text="More key-management actions" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" Padding="16,12,16,10" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <TextBlock Text="SSH / FIDO" Foreground="{StaticResource DisabledBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="●  Not enabled" Foreground="{StaticResource DisabledBrush}" />
                        <TextBlock Text="Hardware-backed SSH flows" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" Padding="16,12,16,10" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <TextBlock Text="PIV / OATH" Foreground="{StaticResource DisabledBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="●  Not enabled" Foreground="{StaticResource DisabledBrush}" />
                        <TextBlock Text="Additional YubiKey services" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="This screen is ready to grow as more signing adapters are added."
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
