<Page
    x:Class="TajsToucher.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="36,28,36,48" Spacing="14">
            <TextBlock Text="Notification personalization"
                       Foreground="{StaticResource InkBrush}"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="Choose how TajsToucher presents Git signing requests."
                       Foreground="{StaticResource MutedBrush}"
                       Margin="0,0,0,8" />

            <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                <TextBlock Text="Notification title" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="TitleTextBox" Grid.Column="1" PlaceholderText="Notification title" />

                <TextBlock Text="Notification text" Grid.Row="1" VerticalAlignment="Top" Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="TextTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         MinHeight="104"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         PlaceholderText="Notification text" />

                <TextBlock Text="Notification icon" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="64,*,Auto,Auto" ColumnSpacing="8">
                    <Border Background="{StaticResource CardBackgroundBrush}" Width="52" Height="52" CornerRadius="2">
                        <Image x:Name="IconPreview" Width="48" Height="48" Stretch="Uniform" />
                    </Border>
                    <TextBox x:Name="IconPathTextBox" Grid.Column="1" VerticalAlignment="Center" PlaceholderText="Optional .ico path" />
                    <Button Grid.Column="2" Content="Browse..." Click="BrowseIcon_Click" />
                    <Button Grid.Column="3" Content="Default" Click="ClearIcon_Click" />
                </Grid>

                <TextBlock Text="Template help" Grid.Row="3" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="Use {Repository} in the title or text. If omitted from the text, the repository is appended automatically."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button Content="Reset defaults" Click="ResetDefaults_Click" />
                <Button Content="Test notification" Click="TestNotification_Click" />
                <Button Content="Save settings" Click="Save_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusLabel" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
