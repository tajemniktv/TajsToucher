<Page
    x:Class="TajsToucher.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TajsToucher.Pages"
    Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32,28,32,48" Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">
            <TextBlock Text="Status, personalization, and connected capabilities in one place."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="13" />
            <TextBlock Text="Your signing setup at a glance"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Margin="0,0,0,2" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="18"
                    CornerRadius="2">
                <Grid ColumnDefinitions="42,*,Auto">
                    <TextBlock x:Name="StatusDot"
                               Text="●"
                               FontSize="20"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="10,0,16,0" Spacing="4">
                        <TextBlock x:Name="StatusTitle"
                                   Text="Needs setup"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="StatusDescription"
                                   Text="Use Install for Git below to connect Git, then keep working from this dashboard."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="See what’s enabled"
                            Click="OpenEnabledFor_Click"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16,12,16,10" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Git / OpenPGP signing" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="SigningValue" Text="Not enabled" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="SigningDetail" Text="Git is not connected yet" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16,12,16,10" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Notifications" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Ready" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Personalized locally" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16,12,16,10" CornerRadius="2">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Real GnuPG" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="GpgValue" Text="Unavailable" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="The underlying signer" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                <Button x:Name="InstallButton" Content="Install for Git" Click="Install_Click" />
                <Button x:Name="UninstallButton" Content="Uninstall" Click="Uninstall_Click" Visibility="Collapsed" />
                <Button Content="Test notification" Click="TestNotification_Click" />
                <Button Content="Open Settings page" Click="OpenSettings_Click" />
                <Button Content="Open Enabled for page" Click="OpenEnabledFor_Click" />
                <TextBlock x:Name="ActionStatus"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <local:SettingsPage x:Name="InlineSettings" Margin="0,20,0,0" />
            <local:EnabledForPage x:Name="InlineEnabledFor" Margin="0,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
